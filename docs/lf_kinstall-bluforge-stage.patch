         'do_iommu=i'                                                        => \$do_iommu,
@@ -4957,6 +4963,17 @@
     for $f (@stat) {
         unlink($f) if (-f $f);
     }
+    if ($bluforge_stage) {
+        # initial staging only: bluforge-bluez previews, refuses a second run, and will not
+        # remove a BlueZ the end-user installed
+        if (-x "/usr/local/sbin/bluforge-bluez") {
+            do_cmd("/usr/local/sbin/bluforge-bluez remove --staging --yes");
+        }
+        else {
+            err("--bluforge_stage: /usr/local/sbin/bluforge-bluez not found - install BluForge first");
+            exit(1);
+        }
+    }
     do_cmd("dnf clean all -y", 1);
 
     @stat = ("/home/lanforge/Downloads",
