     qw(perl-Text-CSV_XS perl-Text-CSV-Separator iperf3 xauth),
     qw(dhcp-server bridge-utils perl-JSON-XS perl-Devel-NYTProf perl-Net-Telnet cups-pdf),
     qw(gnuplot colordiff trash-cli android-tools SDL2-devel ffms2-devel meson gcc make),
-    qw(d-feet bluez bluez-tools libreoffice)
+    qw(d-feet libreoffice)
 ); # pulseaudio   pulseaudio-utils  python3-pulsectl xorg-x11-apps  jnettop spamassassin
+# BluForge Bluetooth Test Appliance: BlueZ is installed by the end-user (bluforge-bluez install),
+# so once staging has removed it a later lf_kinstall run must not put it back.
+if (!-e "/var/lib/bluforge/bluez-staged-removed" && !$bluforge_stage) {
+    @yum_pkgs_warn = (@yum_pkgs_warn, qw(bluez bluez-tools));
+}
 if ($::osveri < 30) {
     @yum_pkgs_warn = (@yum_pkgs_warn, qw(xorg-x11-utils));
 }
