--- a/lf_kinstall.pl
+++ b/lf_kinstall.pl
@@ -1460,6 +1460,10 @@
                   0: disable GUI autostart
                   1: enable GUI autostart
 _
+bluforge_stage: With --do_image_prep, also remove BlueZ for the BluForge Bluetooth Test Appliance.
+               The end-user installs BlueZ later (sudo bluforge-bluez install). Initial staging only; it
+               is a no-op if already done. Requires /usr/local/sbin/bluforge-bluez (shipped by BluForge).
+_
 do_hs20:      Build keys, configure apache ssl and other actions to enable
               this system to act as an HS20-R2 server.  Requires specific
               LANforge configuration as well before this will actually work.
@@ -1887,6 +1891,7 @@
 my $yum_mate_pkgs = "mate-sensors-applet";
 
 my $do_image_prep = 0;
